# Etapa de construcción
FROM node:20-alpine AS builder
WORKDIR /app

# Copiar archivos de dependencias
COPY frontend/package.json frontend/yarn.lock* ./
RUN yarn install --frozen-lockfile

# Copiar el resto del código
COPY frontend/ .

# Crear el archivo .env.production para fijar la URL del backend en el momento de la construcción
RUN echo "NEXT_PUBLIC_API_URL=https://inspol-legal-ai-backend.onrender.com" > .env.production

# Construir la aplicación
RUN yarn build

# Etapa de producción
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copiar los archivos estáticos (necesario)
COPY --from=builder /app/public ./public
# Copiar los artefactos de la construcción en modo 'standalone'
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Exponer el puerto que Render nos asigna
EXPOSE $PORT

# Iniciar la aplicación, usando el puerto de Render
CMD ["sh", "-c", "node server.js --port $PORT"]
