FROM node:20-alpine AS base
WORKDIR /app

# Copiar archivos de dependencias
COPY frontend/package.json frontend/yarn.lock* ./
RUN yarn install --frozen-lockfile

# Copiar todo el código y construir
COPY frontend/ .
RUN yarn build

# Exponer puerto
EXPOSE 3000

# Comando para producción
CMD ["yarn", "start"]
